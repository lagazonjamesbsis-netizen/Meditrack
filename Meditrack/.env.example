# =============================================================================
# MediTrack (PRAMIS) — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# The application DOES NOT ship secrets in git. `.env*` files are gitignored.
# Never commit a real `.env.local`.
#
# Legend:
#   [DEV]  required to run locally  (npm run dev, npm run db:seed, etc.)
#   [BUILD] required to generate the Prisma client and run `next build`
#   [DEPLOY] required on the hosting platform (Vercel project settings)

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------

# [DEV][BUILD][DEPLOY] Pooled connection — used by the app at runtime only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.../meditrack?pgbouncer=true&sslmode=require"

# [BUILD][DEPLOY] Direct (non-pooled) connection — used by the Prisma CLI
# (prisma generate / migrate / push / seed / studio) via prisma.config.ts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.../meditrack?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js v4)
# ---------------------------------------------------------------------------

# [DEV][BUILD][DEPLOY] JWT signing/encryption secret.
# Generate with:  openssl rand -base64 32   (or:  npx auth secret)
NEXTAUTH_SECRET="a-long-random-base64-secret"

# [DEV][BUILD][DEPLOY] Canonical base URL for auth callbacks.
#   Local dev:  http://localhost:3000
#   Production: https://meditrack.vercel.app  (or your custom domain)
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (Vercel Blob) — avatar uploads
# ---------------------------------------------------------------------------

# [DEV][DEPLOY] Blob store read/write API token (Vercel dashboard → Storage).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# [OPTIONAL] Blob store ID / webhook key — only needed if you manage the store
# programmatically (CLI/scripts). Not read by the application code.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Email (Nodemailer → Brevo SMTP) — password reset
# ---------------------------------------------------------------------------

# [DEV][DEPLOY] Brevo SMTP relay host, e.g. smtp-relay.brevo.com
SMTP_HOST="smtp-relay.brevo.com"

# [DEV][DEPLOY] SMTP login username (the Brevo login email).
SMTP_USER="hello@domain.com"

# [DEV][DEPLOY] SMTP API key (Brevo SMTP key; NOT the account password).
SMTP_KEY="your-brevo-smtp-key"

# ---------------------------------------------------------------------------
# Optional / tooling-only (NOT read by the application)
# These come along when you pull the Neon or Vercel dashboard exports and can
# be left empty for local development.
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=""
NEON_PROJECT_ID=""
PGDATABASE=""
PGHOST=""
PGHOST_UNPOOLED=""
PGPASSWORD=""
PGUSER=""
POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_URL_NO_SSL=""
POSTGRES_USER=""
VITE_NEON_AUTH_URL=""
VERCEL_OIDC_TOKEN=""
